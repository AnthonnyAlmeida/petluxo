{
  "name": "petluxo",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/favicon.*", "!/og-image.*", "!/robots.txt", "!/sitemap.xml"]
  }
}
